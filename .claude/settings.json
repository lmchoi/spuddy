{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-destructive.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"Before finishing: does docs/prd.md or the active plan in docs/plans/ need updating based on decisions made this session?\"}'",
            "statusMessage": "Checking plan currency..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm test)",
      "Bash(npx jest *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run check)",
      "Bash(npm run check:full)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)"
    ]
  }
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-destructive.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/Library/Android/sdk/platform-tools"
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm test)",
      "Bash(npx jest *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run check)",
      "Bash(npm run check:full)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(~/Library/Android/sdk/platform-tools/adb devices)",
      "Bash(~/Library/Android/sdk/platform-tools/adb exec-out screencap *)",
      "Bash(~/Library/Android/sdk/platform-tools/adb logcat *)",
      "Bash(git worktree list)"
    ]
  }
}

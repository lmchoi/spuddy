{
  "name": "spuddy",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@expo/cli": "^56.1.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "^8.13.0",
    "@tailwindcss/postcss": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~56.0.8",
    "expo-constants": "~56.0.15",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.13",
    "expo-notifications": "~56.0.15",
    "expo-router": "~56.2.8",
    "expo-sharing": "~56.0.15",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "nativewind": "5.0.0-preview.2",
    "posthog-react-native": "^4.49.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css": "3.0.7",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "prettier": "^3.8.3",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage --watchAll=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npx tsc --noEmit",
    "check": "npm run typecheck && npm test -- --watchAll=false",
    "check:full": "npm run typecheck && npm run lint && npm test -- --watchAll=false",
    "clear:android": "~/Library/Android/sdk/platform-tools/adb shell pm clear host.exp.exponent",
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.env.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/.claude/",
      "/__tests__/helpers/"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**",
      "!**/.expo/**",
      "!**/coverage/**",
      "!**/.claude/**",
      "!app/_layout.tsx",
      "!app/+*.tsx",
      "!app/**/_layout.tsx",
      "!components/**",
      "!constants/**",
      "!src/types.ts",
      "!src/tw/**",
      "!src/db.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 75,
        "functions": 80,
        "lines": 85
      }
    }
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "private": true
}
